<?xml version="1.0"?>
<sdf version="1.9">
    <world name="empty_world">

        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse> 0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>50 50</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    <model name="wall_north"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -4 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 8 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8 1</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 8 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 8 1</size></box></geometry></visual></link></model>
    <model name="partition"><static>true</static><pose>0 2.5 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 3 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 3 1</size></box></geometry></visual></link></model>
    <model name="side_wall"><static>true</static><pose>3 2 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>2 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2 0.2 1</size></box></geometry></visual></link></model>
    <model name="box_obstacle"><static>true</static><pose>-2.5 -1.5 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1 1 1</size></box></geometry></visual></link></model>
    <model name="cylinder_obstacle"><static>true</static><pose>2.5 -2 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></visual></link></model>
    <model name="unmapped_box"><static>true</static><pose>1.5 0 0.5 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.4 0.4 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 1</size></box></geometry></visual></link></model>  
    </world>
</sdf>